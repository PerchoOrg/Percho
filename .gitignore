# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/
next-env.d.ts

# Production builds
build/
dist/

# Environment variables — NEVER commit
.env
.env.local
.env.*.local

# Supabase
supabase/.branches/
supabase/.temp/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# TypeScript build info
*.tsbuildinfo

# Vercel
.vercel
package-lock.json

# Videos — never commit to git, host on Supabase Storage / CF Stream
*.mp4
*.mov
# The hosted customer-study demo is a deliberate static asset (phase134).
!apps/web/public/research/percho-demo-*-720p.mp4
*.webm
*.mkv

# Python venvs — glob, not a list. A named entry only covers the venvs that
# existed when it was written, and the next one gets committed by accident.
.venv*/

# Photo-motion prototype: derived artifacts (depth maps, inpainted plates,
# renders). All regenerable from the scripts — never commit.
scripts/prototypes/photo-motion/.cache/
scripts/prototypes/photo-motion/out/

# Meetup / demo assets
docs/ken-burns/demo/*.mp4
docs/ken-burns/demo-condo/*.mp4
docs/ken-burns/demo/photos/*.jpg
docs/ken-burns/demo-condo/photos/*.jpg
docs/ken-burns/demo/bgm.mp3

# render-worker BGM library (Kevin MacLeod, incompetech.com, CC-BY 4.0).
# Fetched at deploy time via scripts/render-worker/bgm/fetch.sh, not tracked in git.
scripts/render-worker/bgm/*.mp3
scripts/render-worker/bgm/**/*.mp3
__pycache__

# Throwaway diagnostic probes (multi-page session replays etc). These are written
# to reproduce a device bug and are not part of the app; a real reproduction that
# is worth keeping belongs in a *.test.ts file instead.
.probe/
**/.probe/

# Real-ESRGAN ONNX weights (66MB) — scripts/render-worker/models/fetch.sh
scripts/render-worker/models/*.onnx

# Apple signing material. The App Store Connect API key (.p8) is downloadable
# exactly once and grants uploads to the whole account; keep it outside the
# repo (~/.appstoreconnect/private_keys/) and never let these land in a commit.
*.p8
AuthKey_*.p8
*.p12
*.cer
*.mobileprovision
