  "history": [
    {
      "year": "1872",
      "short": "Incorporated",
      "text": "Buford is incorporated on the new railroad between Atlanta and Charlotte, and named for the railway's president, Algernon Sidney Buford."
    },
    {
      "year": "1873",
      "short": "Bona Allen",
      "text": "Bonaparte Allen opens a tannery; it becomes the country's largest maker of hand-tooled saddles and horse collars."
    },
    {
      "year": "1919",
      "short": "Tannery Row",
      "text": "The company builds a shoe factory downtown; today it houses artists' studios."
    },
    {
      "year": "1932",
