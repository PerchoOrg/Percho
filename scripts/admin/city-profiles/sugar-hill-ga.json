  "history": [
    {
      "year": "1939",
      "short": "A town",
      "text": "The General Assembly charters the Town of Sugar Hill on March 24; 599 people are counted the next year."
    },
    {
      "year": "1966",
      "short": "The sugar story",
      "text": "The Atlanta Journal prints the story of the farmer whose 100-pound bag of sugar fell off his wagon; others credit the gold mines' quartz."
    },
    {
      "year": "1975",
      "short": "A city",
      "text": "The town is renamed the City of Sugar Hill."
    },
    {
      "year": "1992",
      "short": "Golf",
      "text": "Sugar Hill Golf Club opens on Suwanee Dam Road."
    },
    {
      "year": "2001",
      "short": "Gas revolt",
      "text": "After a spike in the city utility's gas prices, 1,600 residents petition to dissolve the utility and the city itself; both survive."
    },
    {
      "year": "2013",
      "short": "City Hall",
      "text": "A new City Hall opens on West Broad Street, the first building of a downtown."
    },
    {
      "year": "2018",
      "short": "E Center",
      "text": "The E Center opens beside it: the 406-seat Eagle Theatre, a gym, shops and offices."
    }
  ],
