  "history": [
    {
      "year": "1820s",
      "short": "Howell's Crossing",
      "text": "Cotton merchant Evan Howell cuts a road from his gin on the Chattahoochee to Old Peachtree Road; the crossroads takes his name."
    },
    {
      "year": "1871",
      "short": "Duluth",
      "text": "The railroad arrives and the town is renamed Duluth, after Duluth, Minnesota, whose railroad Rep. J. Proctor Knott had mocked in Congress."
    },
    {
      "year": "1970",
      "short": "Railway museum",
      "text": "The Southeastern Railway Museum is founded; it later moves to Duluth and restores the 1871 depot."
    },
    {
      "year": "1984",
      "short": "Gwinnett Place",
      "text": "Gwinnett Place Mall opens on Pleasant Hill Road and becomes the region's leading mall."
    },
    {
      "year": "2003",
      "short": "The arena",
      "text": "Gas South Arena, then the Gwinnett Arena, opens with about 13,000 seats."
    },
    {
      "year": "2020",
      "short": "County buys the mall",
      "text": "Gwinnett County's redevelopment agency buys the declining mall site to rebuild it as homes, park and shops."
    },
    {
      "year": "2023",
      "short": "Rogers Bridge",
      "text": "The old Rogers Bridge over the Chattahoochee reopens for walkers and cyclists, joining Duluth to Johns Creek."
    }
  ],
