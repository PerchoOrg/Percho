  "history": [
    {
      "year": "Before 1830s",
      "short": "Cherokee land",
      "text": "Cherokee land. The creek, and later the city, is named for Johnson K. Rogers, son of early settler John Rogers."
    },
    {
      "year": "1880s",
      "short": "Farm country",
      "text": "Farms along the Chattahoochee; the Summerour farmhouse of the 1880s now stands at Autrey Mill."
    },
    {
      "year": "1912",
      "short": "Rogers Bridge",
      "text": "A steel bridge carries cotton across the river to the railroad at Duluth; it closes in the 1970s."
    },
    {
      "year": "1967",
      "short": "Athletic Club arrives",
      "text": "The Atlanta Athletic Club moves here from East Lake: 1976 U.S. Open, PGA Championships 1981, 2001, 2011."
    },
    {
      "year": "1981",
      "short": "Technology Park",
      "text": "Georgia Tech graduates buy about 1,700 acres for an office park and name it after the creek on an old map."
    },
    {
      "year": "2006",
      "short": "Becomes a city",
      "text": "Residents vote for cityhood on July 18; Johns Creek is incorporated on December 1."
    },
    {
      "year": "2023",
      "short": "Cauley Creek Park",
      "text": "Cauley Creek Park opens on 203 acres by the river; Rogers Bridge reopens as a footbridge to Duluth."
    },
    {
      "year": "2026",
      "short": "A town center",
      "text": "The Boardwalk at Town Center opens behind City Hall in May; Medley's shops and homes open in October."
    }
  ],
