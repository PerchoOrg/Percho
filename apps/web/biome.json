{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "extends": ["../../biome.base.json"],
  "files": {
    "ignore": [
      ".next",
      "node_modules",
      "supabase/functions/**/deno.lock",
      "lib/supabase/database.types.ts",
      "data/rent-by-zip.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
